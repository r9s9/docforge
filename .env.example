# ---------------------------------------------------------------------------
# DocForge settings for running on your own computer.
# Copy this file to backend/.env and adjust as needed. Never commit your .env.
# ---------------------------------------------------------------------------

# --- Core ---
DOCFORGE_ENV=development
# Where the database, uploads, templates and generated documents are kept.
DOCFORGE_DATA_DIR=./data
DOCFORGE_DATABASE_URL=sqlite:///./data/docforge.db

# One local user, no sign-in.
DOCFORGE_AUTH_REQUIRED=false

# --- Uploads ---
# Largest .docx you can upload, and how many examples per template.
DOCFORGE_MAX_UPLOAD_MB=25
DOCFORGE_MAX_FILES_PER_ANALYSIS=5

# Generated documents are deleted after this many days.
DOCFORGE_GENERATED_RETENTION_DAYS=14

# --- AI (optional) ----------------------------------------------------------
# The easiest way is in the app: Settings -> LLM Settings -> Use recommended
# setup. The settings below are an alternative default key.
#
# provider: "anthropic" (Claude) or "openai" (any OpenAI-compatible API:
# OpenAI, OpenRouter, Gemini, DeepSeek, or a local server such as Ollama or
# LM Studio). With AI off, a deterministic engine does the work and nothing
# leaves your computer.
DOCFORGE_AI_ENABLED=false
DOCFORGE_AI_PROVIDER=anthropic
DOCFORGE_AI_BASE_URL=https://api.anthropic.com
# sk-ant-...
DOCFORGE_AI_API_KEY=
DOCFORGE_AI_MODEL=claude-haiku-5-5

# Claude's effort per step: low | medium | high | xhigh | max.
DOCFORGE_AI_EFFORT_WORKHORSE=low
DOCFORGE_AI_EFFORT_REASONING=medium

# Example: a local model with Ollama
# DOCFORGE_AI_ENABLED=true
# DOCFORGE_AI_PROVIDER=openai
# DOCFORGE_AI_BASE_URL=http://localhost:11434/v1
# DOCFORGE_AI_API_KEY=ollama
# DOCFORGE_AI_MODEL=llama3.1

# --- Logging ---
DOCFORGE_LOG_LEVEL=INFO
# Keep document text out of the logs.
DOCFORGE_LOG_REDACT=true
